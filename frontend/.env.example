# Environment Configuration Template for EcoTwin AI Frontend
# Copy this file to .env.local to customize local parameters.
# NEVER place backend secrets (e.g. XAI_API_KEY) in frontend variables.

# API Base URL
# In local development: leave as /api to use Vite's built-in reverse proxy (http://localhost:8000)
# In production: configure the backend API origin if not running on the same domain
VITE_API_BASE_URL=/api
