# Environment Configuration Template for EcoTwin AI Backend
# Copy this file to .env (or root .env) and configure local values.
# NEVER commit the actual .env file or real secrets to version control.

# Application Environment (development, staging, production)
APP_ENV=development

# Database Persistence (SQLite for prototype)
DATABASE_URL=sqlite:///./ecotwin.db

# Frontend Origin for CORS (comma-separated if multiple)
FRONTEND_ORIGIN=http://localhost:5173

# xAI Grok API Configuration (Backend-only)
XAI_API_KEY=
XAI_MODEL=grok-beta

# Dedicated Computer Vision Provider Configuration (Backend-only)
# Supported options: mock, roboflow, huggingface
VISION_PROVIDER=mock
VISION_API_KEY=
VISION_MODEL=waste-detection-v1

# Upload Limits
MAX_IMAGE_UPLOAD_MB=8
